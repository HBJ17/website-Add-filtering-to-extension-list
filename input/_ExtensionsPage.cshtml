@model IEnumerable<IDocument>

@{
    var extensionType = new List<string> { "Addin", "Module" };

    var extensions =
        Model
            .Where(x =>
                x.String("Type") != null &&
                extensionType.Any(y => y.Equals(x.String("Type"), StringComparison.OrdinalIgnoreCase)))
            .OrderBy(x => x.String("Name"))
            .ToList();

    // Distinct categories (case-insensitive) with the number of extensions using each.
    var categoryCounts =
        extensions
            .SelectMany(x => (x.List<string>("Categories") ?? new List<string>())
                .Where(c => !string.IsNullOrWhiteSpace(c))
                .Select(c => c.Trim().ToLowerInvariant())
                .Distinct())
            .GroupBy(c => c)
            .OrderBy(g => g.Key)
            .Select(g => new { Name = g.Key, Count = g.Count() })
            .ToList();
}

<div class="alert alert-info">
    <i class="fa-solid fa-bug" style="margin-right:20px;" aria-hidden="true"></i>If you want to file an issue for any extension listed here please contact the author of the extension.<br/>
    <i class="fa-solid fa-hand-pointer" style="margin-right:20px;" aria-hidden="true"></i>If you have requests for additional addins <a href="https://github.com/cake-build/cake/discussions?discussions_q=category%3A%22Extension+requests%22" target="_blank">start a discussion</a>.<br/>
    <i class="fa-solid fa-plus" style="margin-right:20px;" aria-hidden="true"></i>If you are an extension author and want to have your extension listed, follow the <a href="https://github.com/cake-build/website/blob/master/README.md#extensions" target="_blank">instructions</a>.<br/>
</div>

<section id="extensions">

    <input id="search" type="text" class="search" aria-label="Enter extensions to search" placeholder="Search for extensions..." autocomplete="off" value>

    <div class="row no-margin">
        <div id="result-count" class="col-md-10 no-padding">
            @extensions.Count() extensions found
        </div>
        <div class="col-md-2 col-xs-3 col-sm-1 text-right no-padding">
            <button class="btn-filter" data-toggle="collapse" data-target="#extension-filter" aria-expanded="false" aria-controls="extension-filter">
                <i class="fa-solid fa-filter"></i>
                Sort &amp; Filter
            </button>
        </div>
    </div>

    <div class="panel panel-default collapse" id="extension-filter">
        <div class="row panel-body">
            <div class="col-md-2" id="type-filter">
                <div>Extension types</div>
                <div class="radio">
                    <label>
                        <input type="radio" class="filterType" name="filterType" id="filterTypeAll" value="" checked>
                        All
                    </label>
                </div>
                <div class="radio">
                    <label>
                        <input type="radio" class="filterType" name="filterType" id="filterTypeAddins" value="Addin">
                        Addins
                    </label>
                </div>
                <div class="radio">
                    <label>
                        <input type="radio" class="filterType" name="filterType" id="filterTypeModules" value="Module">
                        Modules
                    </label>
                </div>
            </div>
            <div class="col-md-2">
                <div>Sort by</div>
                <button class="sort btn btn-default asc" data-sort="name">Name</button>
                <button class="sort btn btn-default" data-sort="analyzedpackagepublishdate" data-default-order="desc">Publish Date</button>
            </div>
            <div class="col-md-6" id="category-filter">
                <div>Categories</div>
                <div class="dropdown" id="category-dropdown">
                    <button class="btn btn-default dropdown-toggle" type="button" id="category-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <span id="category-summary">Any category</span>
                        <span class="caret"></span>
                    </button>
                    <div class="dropdown-menu category-menu" aria-labelledby="category-toggle">
                        <input id="category-search" type="search" class="form-control input-sm" aria-label="Filter the list of categories" placeholder="Filter categories..." autocomplete="off">
                        <ul class="list-unstyled category-options" id="category-options">
                            @foreach (var category in categoryCounts)
                            {
                                <li data-category="@category.Name">
                                    <div class="checkbox">
                                        <label>
                                            <input type="checkbox" class="filterCategory" value="@category.Name">
                                            @category.Name <span class="text-muted">(@category.Count)</span>
                                        </label>
                                    </div>
                                </li>
                            }
                        </ul>
                        <div class="category-menu-footer">
                            <button type="button" class="btn btn-link btn-sm" id="category-clear">Clear categories</button>
                        </div>
                    </div>
                </div>
                <div id="category-chips" class="category-chips" aria-live="polite"></div>
            </div>
        </div>
    </div>

    @Html.Partial("_ExtensionsList", extensions)
</section>

<script src="//cdnjs.cloudflare.com/ajax/libs/list.js/1.5.0/list.min.js"></script>
<script>
    var options = {
      valueNames: [
        { data: ['type'] },
        { data: ['name'] },
        { data: ['analyzedpackagepublishdate'] },
        { data: ['categories'] }
      ]
    };

    var extensionList = new List('extensions', options);

    var selectedType = '';
    var selectedCategories = [];

    function updateResultCount() {
        document.getElementById("result-count").innerHTML = extensionList.update().matchingItems.length + " extensions found";
    }

    // List.js only keeps a single filter function, so type and category filters are combined here.
    function applyFilters() {
        if (!selectedType && selectedCategories.length === 0) {
            extensionList.filter();
        }
        else {
            extensionList.filter(function(item) {
                var values = item.values();

                if (selectedType && values.type !== selectedType) {
                    return false;
                }

                if (selectedCategories.length === 0) {
                    return true;
                }

                // An extension matches if it has ANY of the selected categories.
                var itemCategories = (values.categories || '').split('|');
                return selectedCategories.some(function(category) {
                    return itemCategories.indexOf(category) !== -1;
                });
            });
        }

        updateResultCount();
        updateUrl();
    }

    // Reflect the active filters in the query string (?type=Addin&category=aws) so a view can be shared.
    function updateUrl() {
        if (!window.history || !window.history.replaceState || !window.URLSearchParams) {
            return;
        }

        var params = new URLSearchParams(window.location.search);
        params.delete('type');
        params.delete('category');

        if (selectedType) {
            params.set('type', selectedType);
        }

        selectedCategories.forEach(function(category) {
            params.append('category', category);
        });

        var query = params.toString();
        window.history.replaceState(null, '', window.location.pathname + (query ? '?' + query : '') + window.location.hash);
    }

    function restoreFiltersFromUrl() {
        if (!window.URLSearchParams) {
            return;
        }

        var params = new URLSearchParams(window.location.search);

        // Only accept values that exist on the page.
        var type = params.get('type');
        var $typeRadio = $('.filterType').filter(function() { return type && this.value.toLowerCase() === type.toLowerCase(); });
        if ($typeRadio.length) {
            selectedType = $typeRadio.val();
            $typeRadio.prop('checked', true);
        }

        var available = $('.filterCategory').map(function() { return this.value; }).get();
        var categories = params.getAll('category')
            .map(function(category) { return category.trim().toLowerCase(); })
            .filter(function(category, index, all) { return available.indexOf(category) !== -1 && all.indexOf(category) === index; });

        if (selectedType || categories.length) {
            $('#extension-filter').addClass('in');
            $('.btn-filter').attr('aria-expanded', 'true');
            setSelectedCategories(categories);
        }
    }

    function renderCategoryState() {
        $('.filterCategory').each(function() {
            this.checked = selectedCategories.indexOf(this.value) !== -1;
        });

        $('#category-summary').text(
            selectedCategories.length === 0 ? 'Any category' : selectedCategories.length + ' selected');

        var $chips = $('#category-chips').empty();
        selectedCategories.forEach(function(category) {
            var $remove = $('<button type="button" class="category-chip-remove"></button>')
                .attr('aria-label', 'Remove category ' + category)
                .data('category', category)
                .html('&times;');
            $('<span class="category-chip"></span>').text(category).append($remove).appendTo($chips);
        });
    }

    function setSelectedCategories(categories) {
        selectedCategories = categories;
        renderCategoryState();
        applyFilters();
    }

    extensionList.on('searchComplete', updateResultCount);

    $('.filterType').on('change', function() {
        selectedType = this.value;
        applyFilters();
    });

    // Keep the dropdown open while ticking several categories.
    $('#category-dropdown .dropdown-menu').on('click', function(e) {
        e.stopPropagation();
    });

    $('.filterCategory').on('change', function() {
        var value = this.value;
        var categories = selectedCategories.filter(function(category) { return category !== value; });

        if (this.checked) {
            categories.push(value);
        }

        setSelectedCategories(categories);
    });

    $('#category-chips').on('click', '.category-chip-remove', function() {
        var value = $(this).data('category');
        setSelectedCategories(selectedCategories.filter(function(category) { return category !== value; }));
    });

    $('#category-clear').on('click', function() {
        setSelectedCategories([]);
    });

    $('#category-search').on('input', function() {
        var term = this.value.trim().toLowerCase();
        $('#category-options li').each(function() {
            // attr() keeps the value a string; data() would turn a numeric-looking category into a number.
            $(this).toggle(String($(this).attr('data-category')).indexOf(term) !== -1);
        });
    });

    restoreFiltersFromUrl();
</script>